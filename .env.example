# Public project URL and publishable key only. Never put service-role/secret keys here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Exact browser origin for forwarded Codespaces URLs / CSRF checks; no trailing path.
# SOS_APP_ORIGIN=https://YOUR-CODESPACE-3000.app.github.dev
